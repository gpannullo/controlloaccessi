[Unit]
Description=Protocollazione report giornalieri visitatori e passaggi QR
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=controlloaccessi
Group=controlloaccessi
WorkingDirectory=/var/www/controlloaccessi/app
EnvironmentFile=/etc/controlloaccessi.env
ExecStart=/var/www/controlloaccessi/venv/bin/python manage.py protocolla_report_giornalieri --invia
UMask=0077
TimeoutStartSec=1800
NoNewPrivileges=true
