[Unit]
Description=Demone importazione timbrature personale ControlloAccessi
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=controlloaccessi
Group=controlloaccessi
WorkingDirectory=/var/www/controlloaccessi/app
EnvironmentFile=/etc/controlloaccessi.env
ExecStart=/var/www/controlloaccessi/venv/bin/python manage.py watch_timbrature
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
