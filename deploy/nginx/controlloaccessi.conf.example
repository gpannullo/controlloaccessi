# Copiare in /etc/nginx/sites-available/controlloaccessi e creare il link in
# sites-enabled. Sostituire i percorsi del certificato e verificare la rete
# VPN prima di abilitarlo. L'app Gunicorn deve ascoltare su 127.0.0.1:8000.

upstream controlloaccessi_app {
    server 127.0.0.1:8000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Un certificato SAN/wildcard può coprire i tre host. Inserire qui i percorsi
# effettivi rilasciati da Let's Encrypt o dalla CA comunale.
# ssl_certificate     /etc/nginx/certs/comuneaversa/fullchain.pem;
# ssl_certificate_key /etc/nginx/certs/comuneaversa/privkey.pem;

server {
    listen 80;
    server_name ticket.comune.aversa.ce.it account.comune.aversa.ce.it controlloaccessi.comune.aversa.ce.it;
    return 301 https://$host$request_uri;
}

# Pubblico: esclusivamente stato coda identificato dal token del QR.
server {
    listen 443 ssl http2;
    server_name ticket.comune.aversa.ce.it;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location ^~ /attesa/ {
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://controlloaccessi_app;
    }

    location / { return 404; }
}

# Pubblico: solo autenticazione, completamento profilo e gestione della
# password dell'utente autenticato. Django applica la stessa regola.
server {
    listen 443 ssl http2;
    server_name account.comune.aversa.ce.it;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location = /accounts/login/ { include proxy_params; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_pass http://controlloaccessi_app; }
    location = /accounts/logout/ { include proxy_params; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_pass http://controlloaccessi_app; }
    location ^~ /account/ { include proxy_params; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_pass http://controlloaccessi_app; }
    location ^~ /static/ { alias /var/www/controlloaccessi/app/staticfiles/; }
    location / { return 404; }
}

# Interno: il firewall/reverse proxy blocca l'accesso esterno prima di Django.
server {
    listen 443 ssl http2;
    server_name controlloaccessi.comune.aversa.ce.it;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    # Rete comunale rilevata. Aggiungere qui la subnet reale della VPN.
    allow 10.0.3.0/24;
    # allow 10.x.y.0/24;  # VPN: sostituire con la subnet effettiva
    deny all;

    location ^~ /static/ { alias /var/www/controlloaccessi/app/staticfiles/; }

    location / {
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://controlloaccessi_app;
    }
}
