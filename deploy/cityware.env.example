# Non abilitare prima del collaudo concordato con l'ufficio Protocollo.
PROTOCOLLAZIONE_ENABLED=false
PROTOCOLLAZIONE_BACKEND=cityware.backend.CitywareBackend
# Endpoint SOAP effettivo, NON URL con ?wsdl.
CITYWARE_ENDPOINT=
# Base delle soapAction nel WSDL dell'ente; puo' usare http come identificatore
# anche se l'endpoint di trasporto DEVE essere https.
CITYWARE_SOAP_ACTION_BASE=
CITYWARE_USERNAME=
CITYWARE_PASSWORD=
CITYWARE_DOMAIN_CODE=
CITYWARE_UFFICIO_OPERATORE=
CITYWARE_FIRMATARIO=
CITYWARE_UFFICIO_FIRMATARIO=
CITYWARE_CA_BUNDLE=
CITYWARE_CONNECT_TIMEOUT=10
CITYWARE_TIMEOUT=60
CITYWARE_MAX_DOCUMENT_BYTES=20971520
